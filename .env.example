# ==============================================================================
# PALABRARIO - EJEMPLO DE VARIABLES DE ENTORNO UNIFICADAS Y DOCUMENTADAS
# ==============================================================================
# Este archivo documenta TODAS las variables de entorno requeridas por la plataforma,
# su propósito de negocio, restricciones técnicas, valores de desarrollo y
# consideraciones de despliegue en producción.
#
# REGLA DE ARQUITECTURA (Fail-Fast):
# Los microservicios en Go no arrancarán y arrojarán un error fatal si las variables
# marcadas como [OBLIGATORIA] no están presentes en el entorno.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRAESTRUCTURA DE BASE DE DATOS (PostgreSQL 17)
# ------------------------------------------------------------------------------
# PGUSER [OBLIGATORIA para Docker Compose]:
# Usuario administrador del motor PostgreSQL.
PGUSER=postgres

# PGPASSWORD [OBLIGATORIA para Docker Compose]:
# Contraseña de la base de datos.
# SEGURIDAD: En producción, utilice un secreto aleatorio de alta entropía (>= 32 caracteres).
PGPASSWORD=postgres

# PGDATABASE [OBLIGATORIA para Docker Compose]:
# Nombre de la base de datos principal de Palabrario.
PGDATABASE=palabrario

# PGPORT [OPCIONAL, por defecto 5432]:
# Puerto expuesto en el host para conexiones locales y herramientas (DBeaver, psql).
PGPORT=5432


# ------------------------------------------------------------------------------
# 2. CORE SERVICE (Backend REST / Dominio Lingüístico y Gamificación en Go)
# ------------------------------------------------------------------------------
# PORT [OBLIGATORIA]:
# Puerto TCP en el que el servidor HTTP Chi escuchará las peticiones entrantes.
# Ejemplo desarrollo: 8000
PORT=8000

# ENVIRONMENT [OBLIGATORIA]:
# Entorno de ejecución: 'development', 'staging' o 'production'.
# Controla el nivel de verbosidad de logs y políticas de depuración.
ENVIRONMENT=development

# DATABASE_URL [OBLIGATORIA]:
# Cadena de conexión estandarizada (PostgreSQL URI) para el pool de conexiones (pgxpool).
# Formato: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=<mode>
# Nota para Docker: Dentro de la red de contenedores, el host es 'postgres'.
# Nota para Local/Host: Desde Windows/Host local, el host es 'localhost'.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/palabrario?sslmode=disable

# JWT_SECRET [OBLIGATORIA]:
# Clave simétrica secreta utilizada para firmar y verificar tokens HMAC-SHA256 (RFC 7519).
# SEGURIDAD CRÍTICA:
# - No debe tener valores por defecto en el código binario.
# - En producción DEBE ser una cadena criptográficamente segura (mínimo 32 bytes aleatorios).
# - Si esta variable no está presente, el servicio se niega a iniciar para evitar vulnerabilidades.
JWT_SECRET=super_secret_jwt_key_palabrario_change_in_production_min_32_chars

# JWT_EXPIRATION_HOURS [OPCIONAL, default 72]:
# Tiempo de expiración de las credenciales de sesión en horas.
JWT_EXPIRATION_HOURS=72

# IMAGE_SERVICE_URL [OBLIGATORIA si se integran módulos multimedia]:
# Dirección URL base interna para comunicación entre microservicios hacia image-service.
IMAGE_SERVICE_URL=http://image-service:8002

# REALTIME_SERVICE_URL [OBLIGATORIA si se integra Arena Multijugador]:
# Dirección URL base interna para comunicación hacia el microservicio en tiempo real.
REALTIME_SERVICE_URL=http://realtime-service:8001


# ------------------------------------------------------------------------------
# 3. IMAGE SERVICE (Procesamiento y Validación de Imágenes en Go)
# ------------------------------------------------------------------------------
# IMAGE_SERVICE_PORT [OBLIGATORIA en el servicio]:
# Puerto TCP en el que escucha el microservicio de imágenes.
IMAGE_SERVICE_PORT=8002

# MAX_FILE_SIZE_MB [OBLIGATORIA]:
# Tamaño máximo permitido en megabytes para la carga de imágenes (avatares, vocabulario).
# Previene ataques de denegación de servicio (DoS) por agotamiento de memoria.
MAX_FILE_SIZE_MB=5

# ALLOWED_IMAGE_MIME_TYPES [OPCIONAL, por defecto image/jpeg,image/png,image/webp]:
# Lista separada por comas de formatos MIME autorizados para ingestión multimedia.
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp


# ------------------------------------------------------------------------------
# 4. REALTIME SERVICE (WebSockets / Multijugador Arena en Bun/Go)
# ------------------------------------------------------------------------------
# REALTIME_PORT [OBLIGATORIA en el servicio]:
# Puerto TCP en el que escucha el microservicio de WebSockets.
REALTIME_PORT=8001

# WS_HEARTBEAT_INTERVAL_SEC [OPCIONAL, default 30]:
# Frecuencia en segundos de los paquetes PING/PONG para mantener vivas las conexiones.
WS_HEARTBEAT_INTERVAL_SEC=30
